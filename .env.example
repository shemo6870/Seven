# Paymob Configuration (Egypt Payment Gateway - New Unified Checkout)
# احصل على هذه البيانات من لوحة تحكم Paymob (https://paymob.com)
# يجب استخدام Secret Key الذي يبدأ بـ sk_ لإتمام عملية الدفع الموحد (Unified Checkout)
PAYMOB_SECRET_KEY=your_paymob_secret_key_here
# PAYMOB_INTEGRATION_ID مطلوب في وضع الدفع الموحد. 
# احصل عليه من: Paymob Dashboard -> Developers -> Payment Integrations
# تأكد من أنه رقم (مثلاً: 123456) وأنه خاص ببيئة الـ Live
PAYMOB_INTEGRATION_ID=

# App URL (Use your development URL or localhost)
APP_URL=http://localhost:3000
